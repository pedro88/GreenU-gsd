// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// NextAuth Required Models
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// User Model
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Localization
  language   String @default("en") // en, fr, es
  latitude   Float?  // GPS coordinates (optional)
  longitude  Float?

  // Social counts (updated atomically on follow/unfollow)
  followerCount  Int @default(0)
  followingCount Int @default(0)

  // Relations
  accounts    Account[]
  sessions    Session[]
  gardens     Garden[]
  followers   Follow[]       @relation("Following")
  following   Follow[]      @relation("Follower")
  gardenAccess   GardenAccess[]
  gardenInvites GardenInvite[]
  conversations ConversationParticipant[]
  messages     Message[]
  clients       Client[]
  assignedTasks Task[]
  userStats     UserStats?
  articles       Article[]
}

// ============================================
// Article Models
// ============================================

model Article {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String    @db.Text // HTML content from TipTap
  excerpt     String?   // Short description for article cards
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  published   Boolean   @default(false)
  tags        ArticleTag[]
  viewCount   Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique // e.g. "tomatoes", "composting", "beginner"
  slug     String       @unique
  articles ArticleTag[]
}

model ArticleTag {
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

// ============================================
// Garden Hierarchy Models
// ============================================

/// Garden - top level container for a user's garden
model Garden {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  location    String?
  isPublic    Boolean  @default(false)
  followerCount Int    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  zones Zone[]
  collaborators GardenAccess[]
  invites       GardenInvite[]
  conversations Conversation[]
  tasks         Task[]

  @@index([userId])
}

/// Zone - section within a garden (e.g., raised bed 1, greenhouse A)
model Zone {
  id        String   @id @default(cuid())
  gardenId  String
  name      String
  type      ZoneType @default(OUTDOOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  garden Garden @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  plots  Plot[]

  @@index([gardenId])
}

enum ZoneType {
  OUTDOOR
  GREENHOUSE
  ORCHARD
  INDOOR
  TERRACE
}

/// Plot - individual growing area within a zone
model Plot {
  id          String    @id @default(cuid())
  zoneId      String
  name        String
  sizeSqFt    Float?
  soilType    String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  zone        Zone           @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  crops       Crop[]
  rotationLog RotationLog[]

  @@index([zoneId])
}

/// Crop - instance of a plant type planted in a plot
model Crop {
  id           String        @id @default(cuid())
  plotId       String
  plantTypeId  String
  plantedDate  DateTime
  harvestedDate DateTime?
  status       CropStatus    @default(PLANTED)
  quantity     Float?        // Number of plants planted
  harvestYield Float?        // Actual harvest amount
  
  // Seed information
  seedBrand   String?        // Brand/manufacturer of seeds
  seedVariety String?        // Specific variety name
  seedLot     String?        // Lot number (for traceability)
  
  // Planting details
  plantingDistance Float?     // Spacing between plants (cm)
  
  // Notes
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  plot      Plot                @relation(fields: [plotId], references: [id], onDelete: Cascade)
  plantType PlantType           @relation(fields: [plantTypeId], references: [id])
  events    CultivationEvent[]

  @@index([plotId])
  @@index([plantTypeId])
}

enum CropStatus {
  PLANTED
  SEEDLING
  VEGETATIVE
  FLOWERING
  FRUITING
  HARVESTING
  HARVESTED
  FAILED
}

/// CultivationEvent - tracked actions on a crop
model CultivationEvent {
  id        String          @id @default(cuid())
  cropId    String
  eventType EventType
  date      DateTime
  notes     String?
  quantity  Float?          // Amount for watering, fertilizing, etc.
  createdAt DateTime        @default(now())

  crop Crop @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@index([cropId])
}

enum EventType {
  SOWING
  TRANSPLANTING
  WATERING
  FERTILIZING
  PRUNING
  PEST_CONTROL
  HARVEST
  NOTE
  OTHER
}

// ============================================
// Plant Knowledge Base
// ============================================

/// PlantType - catalog of plant varieties
model PlantType {
  id           String   @id @default(cuid())
  name         String   @unique  // e.g., "Tomato", "Basil", "Carrot"
  familyId     String
  daysToMaturity Int?
  plantingDepth String?
  spacing      String?
  sunRequirement String?
  createdAt    DateTime @default(now())

  family   PlantFamily @relation(fields: [familyId], references: [id])
  crops    Crop[]
  rulesAsPlant1 CompanionRule[] @relation("Plant1")
  rulesAsPlant2 CompanionRule[] @relation("Plant2")

  @@index([familyId])
}

/// PlantFamily - botanical family grouping
model PlantFamily {
  id          String   @id @default(cuid())
  name        String   @unique  // e.g., "Solanaceae", "Brassicaceae", "Fabaceae"
  description String?
  nitrogenFixer Boolean @default(false)  // Legumes fix nitrogen

  plantTypes PlantType[]
  rotationLogs RotationLog[]

  @@index([name])
}

/// CompanionRule - relationship between two plant types
model CompanionRule {
  id           String             @id @default(cuid())
  plant1Id     String
  plant2Id     String
  relationship CompanionRelationship
  description  String?            // Why this relationship exists
  createdAt    DateTime          @default(now())

  plant1 PlantType @relation("Plant1", fields: [plant1Id], references: [id])
  plant2 PlantType @relation("Plant2", fields: [plant2Id], references: [id])

  @@unique([plant1Id, plant2Id])
  @@index([plant1Id])
  @@index([plant2Id])
}

enum CompanionRelationship {
  COMPANION   // Good together
  INCOMPATIBLE // Should not be planted together
  NEUTRAL     // No significant effect
}

// ============================================
// Crop Rotation Tracking
// ============================================

/// RotationLog - historical record of plant families in a plot
model RotationLog {
  id         String   @id @default(cuid())
  plotId     String
  familyId   String
  year       Int
  season     String   // "Spring", "Summer", "Fall", "Year-round"
  createdAt  DateTime @default(now())

  plot   Plot      @relation(fields: [plotId], references: [id], onDelete: Cascade)
  family PlantFamily @relation(fields: [familyId], references: [id])

  @@unique([plotId, year, season])
  @@index([plotId])
}

// ============================================
// Social / Follow System
// ============================================

/// Follow - relationship between two users
model Follow {
  id          String   @id @default(cuid())
  followerId  String   // The user who is following
  followingId String   // The user being followed
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// ============================================
// Collaborative Garden Access
// ============================================

/// GardenAccess - collaborator access to a garden
model GardenAccess {
  id       String         @id @default(cuid())
  userId   String
  gardenId String
  role     GardenRole
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  garden Garden @relation(fields: [gardenId], references: [id], onDelete: Cascade)

  @@unique([userId, gardenId])
  @@index([userId])
  @@index([gardenId])
}

enum GardenRole {
  EDITOR
  VIEWER
}

/// GardenInvite - pending invite to a garden
model GardenInvite {
  id        String   @id @default(cuid())
  gardenId  String
  email     String
  role      GardenRole
  token     String   @unique
  invitedBy String   // userId of inviter
  expiresAt DateTime
  createdAt DateTime @default(now())

  garden   Garden @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  inviter  User   @relation(fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([gardenId])
  @@index([token])
}

// ============================================
// Messaging
// ============================================

/// Conversation - a message thread between users
model Conversation {
  id           String   @id @default(cuid())
  gardenId     String?  // Optional: linked to a specific garden
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  garden    Garden?    @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  messages  Message[]
  participants ConversationParticipant[]

  @@index([gardenId])
}

/// ConversationParticipant - junction table for conversation participants
model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

/// Message - a single message in a conversation
model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String   @db.Text
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender      User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

// ============================================
// Pro Client Management
// ============================================

/// Client - a professional grower's client
model Client {
  id        String   @id @default(cuid())
  userId    String   // Pro user who owns this client
  name      String
  email     String?
  phone     String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks  Task[]

  @@index([userId])
}

/// Task - a work task assigned to a collaborator on a garden
model Task {
  id          String      @id @default(cuid())
  clientId    String?      // Optional: linked to a client
  gardenId    String?      // Optional: linked to a garden
  assigneeId  String       // User ID of assignee (must be garden collaborator)
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(PENDING)
  dueDate     DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  client   Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  garden   Garden?  @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  assignee User     @relation(fields: [assigneeId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([gardenId])
  @@index([assigneeId])
  @@index([status])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

// ============================================
// Gamification
// ============================================

/// UserStats - per-user gamification state
model UserStats {
  id             String   @id @default(cuid())
  userId         String   @unique
  totalXp        Int      @default(0)
  level          Int      @default(1)
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveDate DateTime @default(now()) // Date only (time stripped in service layer)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  xpEvents     XpEventLog[]
  achievements  UserAchievement[]
  quests       UserQuest[]

  @@index([userId])
  @@index([totalXp])
}

/// XpEventLog - immutable log of every XP award
model XpEventLog {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    XpReason
  metadata  String?  // JSON string with extra context (e.g. {"cropId": "...", "eventType": "HARVEST"})
  createdAt DateTime @default(now())

  user UserStats @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

enum XpReason {
  GARDEN_CREATE    // +200 XP — create first garden
  SOW               // +50 XP — sow a crop
  HARVEST           // +100 XP — harvest a crop
  WATER             // +10 XP — water a crop
  FERTILIZE         // +15 XP — fertilize
  PRUNE             // +10 XP — prune
  PEST_CONTROL      // +20 XP — pest control
  NOTE              // +15 XP — add a note
  FIRST_LOGIN       // +10 XP — first action of the day (streak bonus)
  STREAK_BONUS      // +(streak × 5) XP — streak maintained
  QUEST_COMPLETE    // varies — quest XP reward
  ACHIEVEMENT       // varies — achievement XP reward
  LEVEL_UP          // +50 XP — level up bonus
  SOCIAL_SHARE      // +30 XP — share a garden
  FIRST_FOLLOWER    // +50 XP — get first follower
  INVITE_FRIEND     // +100 XP — invite someone
}

/// Achievement - definition of an achievement
model Achievement {
  id            String          @id @default(cuid())
  code          String          @unique // e.g. "first_harvest", "level_5"
  name          String          // Display name
  description   String          // How to unlock
  icon          String          // Emoji or icon identifier
  category      AchievementCategory
  rarity        AchievementRarity @default(COMMON)
  criteriaType  String          // e.g. "harvest_count", "level", "streak"
  criteriaValue Int             // Threshold value
  xpReward      Int             // XP bonus on unlock
  createdAt     DateTime        @default(now())

  userAchievements UserAchievement[]

  @@index([criteriaType])
  @@index([category])
}

enum AchievementCategory {
  CULTIVATION  // Plant, harvest, crop-related
  SOCIAL        // Followers, sharing, messaging
  STREAKS       // Daily streaks
  LEVELS        // Level milestones
  SPECIAL       // Rare/complex achievements
}

enum AchievementRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

/// UserAchievement - tracks which achievements a user has unlocked
model UserAchievement {
  id           String   @id @default(cuid())
  userId       String
  achievementId String
  unlockedAt   DateTime @default(now())

  user       UserStats   @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

/// Quest - quest template and active user quests
model Quest {
  id            String    @id @default(cuid())
  type          QuestType // DAILY or SEASONAL
  title         String
  description   String
  targetMetric  String    // e.g. "harvest", "sow", "water", "note"
  targetValue   Int       // Number to reach
  xpReward      Int
  icon          String    // Emoji or icon
  seasonStart   DateTime? // For seasonal: when the challenge starts
  seasonEnd     DateTime? // For seasonal: when the challenge ends
  createdAt    DateTime  @default(now())

  userQuests UserQuest[]

  @@index([type])
  @@index([seasonStart, seasonEnd])
}

enum QuestType {
  DAILY   // Refreshes every day at midnight UTC
  SEASONAL // Monthly gardening challenges
}

/// UserQuest - tracks a user's progress on a quest
model UserQuest {
  id          String    @id @default(cuid())
  userId      String
  questId     String
  progress    Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  UserStats @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@index([userId])
  @@index([completed])
}
